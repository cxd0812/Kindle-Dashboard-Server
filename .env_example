# --- Server Configuration ---
PORT=5000
HOST=0.0.0.0

# --- Location Configuration ---
# 开启通过 IP 地址自动获取经纬度、城市名称与时区 (默认 True)
AUTO_LOCATION=True

# 兜底地理位置配置 (当 AUTO_LOCATION=False 或公网 IP 逆地理查询失败时使用)
LATITUDE=39.90420
LONGITUDE=116.40740
CITY_NAME=Beijing
TIMEZONE=Asia/Shanghai

# --- Screen Configuration ---
# Kindle 屏幕分辨率 (例如 Oasis 2 横屏 1680x1264，或 800x600 等)
SCREEN_WIDTH=1680
SCREEN_HEIGHT=1264

# --- Locale & Localization ---
# LANGUAGE options: CN (Chinese), EN (English)
LANGUAGE=CN
# Holiday Country Code (for `holidays` python library) e.g., CN, SG, US
HOLIDAY_COUNTRY=CN

# --- Cache Durations (seconds) ---
CACHE_TTL_WEATHER=600
CACHE_TTL_RENDER=60

# --- Work/Commute Logic ---
# Logic: If current time is before START, show weather at START. If before END, show weather at END.
WORK_START_HOUR=10
WORK_END_HOUR=18

# --- Todo System Configuration ---
# 待办事项数据持久化存储目录 (Docker 部署时可将该目录挂载至宿主机)
TODO_DATA_DIR=data
